# Copy to .env and fill in values.
# For local Docker: cp .env.example .env

IMAGE_TAG=dev

POSTGRES_PASSWORD=change-me-local
JWT_SECRET=change-me-local-jwt-secret-min-32-chars

APP_URL=http://localhost:3000

# Local Postgres — start with: docker compose up -d postgres
# Password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://kodem:change-me-local@localhost:5432/kodem

# OAuth — Google Sign-In
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web)
# Authorized JavaScript origins: http://localhost:3000  (or your APP_URL)
# Authorized redirect URIs:     http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
#
# If left unset, docker-compose uses safe local placeholders so the API can boot.

# Dev server (Oracle bootstrap creates /opt/kodem/.env):
# APP_URL=https://dev.kodem.co.il
# IMAGE_TAG=dev

# Production server (/opt/kodem/.env):
# APP_URL=https://app.kodem.co.il
# IMAGE_TAG=v-1.0.0
