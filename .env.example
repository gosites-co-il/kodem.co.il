# Copy to .env and fill in values.
# For local Docker: cp .env.example .env

IMAGE_TAG=dev

# Leave empty to use locally built images. To pull the images CI published, run
# `az acr login --name <registry>` and set this to `<registry>.azurecr.io/`
# (the trailing slash matters).
REGISTRY_PREFIX=

POSTGRES_PASSWORD=change-me-local

# ---------------------------------------------------------------------------
# CONNECTION_CREDENTIALS_KEY — encrypts Connection OAuth tokens / API keys at rest
# (AES-256-GCM). Required before using Connections in any real environment.
# - Min length: 16 characters
# - Generate: openssl rand -base64 32
# - Keep stable per environment; changing it breaks decrypt of existing connections
# - Do not reuse JWT_SECRET; never commit the real value
# Docs: docs/01-product/connections/google-sheets.md
# Overview: docs/01-product/connections-and-channels.md
# ---------------------------------------------------------------------------
CONNECTION_CREDENTIALS_KEY=change-me-local-connection-credentials-key

APP_URL=http://localhost:3000

# Local Postgres — start with: docker compose up -d postgres
# Password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://kodem:change-me-local@localhost:5432/kodem

# Auth token TTLs (milliseconds unless noted)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1209600000
PASSWORD_RESET_TOKEN_TTL=3600000
EMAIL_VERIFICATION_TOKEN_TTL=86400000
INVITE_TOKEN_TTL=604800000

# Cookies — set true behind HTTPS; false for local http
# Refresh cookie is HttpOnly + SameSite=Lax on the API host (/api/auth).
# Access token remains Bearer (and optional short-lived client cookie for middleware).
COOKIE_SECURE=false

# Mail (stub provider logs to console until configured)
MAIL_PROVIDER=stub
MAIL_FROM=noreply@kodem.local
# SMTP — set MAIL_PROVIDER=smtp and fill these for real delivery
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Prod signup alerts (sent only when FEATURE_FLAG_ENV=production)
SIGNUP_ADMIN_EMAIL=admin@kodem.co.il

# Feature flags environment scope
FEATURE_FLAG_ENV=development

# Workspace subdomains — check-only via Cloudflare DNS (optional locally)
# When unset, slug availability falls back to DB uniqueness only.
WORKSPACE_SUBDOMAIN_SUFFIX=.app.kodem.co.il
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Worker platform cleanup interval (ms); default 1 hour
PLATFORM_CLEANUP_MS=3600000

# OAuth — Google Sign-In
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web)
# Authorized JavaScript origins: http://localhost:3000  (or your APP_URL)
# Authorized redirect URIs:     http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Workspace Connections (not login OAuth)
# Dedicated OAuth client PER connection — never reuse GOOGLE_CLIENT_ID above.
# Pattern: {INTEGRATION_ID}_CLIENT_ID / _CLIENT_SECRET / _CALLBACK_URL
# Install guide: docs/01-product/connections/google-sheets.md
# All connections/channels: docs/01-product/connections/ | docs/01-product/channels/
#
# Google Sheets (available):
# 1. Google Cloud Console → new OAuth client (Web), separate from Sign-In
# 2. Enable Google Sheets API (+ Drive API if needed)
# 3. Authorized redirect URI must match exactly (local):
#    http://localhost:3000/api/connections/oauth/google/google_sheets/callback
# 4. Paste Client ID / Secret below; leave blank to boot without Sheets connect
# Azure deploy uses OAUTH_GOOGLE_SHEETS_CLIENT_ID / _SECRET (see deploy/azure/README.md)
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_CALLBACK_URL=http://localhost:3000/api/connections/oauth/google/google_sheets/callback

# Google Analytics (available) — enable Analytics Admin API + Analytics Data API
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_CALLBACK_URL=http://localhost:3000/api/connections/oauth/google/google_analytics/callback

# Google Business Profile (available) — enable Business Profile APIs
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_CALLBACK_URL=http://localhost:3000/api/connections/oauth/google/google_business/callback

# Google Workspace (available) — enable Gmail API; backs Email Channel stubs
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_CALLBACK_URL=http://localhost:3000/api/connections/oauth/google/google_workspace/callback

# Google Ads — next phase (needs developer token)
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=

# Login OAuth (optional) — GitHub / Facebook Sign-In
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
#
# If left unset, docker-compose uses safe local placeholders so the API can boot.

# Deployed environments run on Azure Container Apps and get their configuration from
# GitHub Environment variables and secrets, not from this file. See deploy/azure/README.md.
