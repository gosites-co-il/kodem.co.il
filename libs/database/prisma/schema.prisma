generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-saas"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id               String   @id
  name             String
  slug             String   @unique
  ownerId          String
  status           String   @default("active")
  onboardingStatus String   @default("NOT_STARTED")
  onboardingStep   Int      @default(0)
  websiteUrl       String?
  industry         String?
  businessSize     String?
  setupData        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner             User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members           Member[]
  events            Event[]
  profiles          BusinessProfile[]
  businessReports   BusinessReport[]
  insights          InsightRecord[]
  recommendations   RecommendationRecord[]
  subscription      Subscription?
  invites           WorkspaceInvite[]
  modules           WorkspaceModule[]
  usageEvents       UsageEvent[]
  auditEvents       AuditEvent[]
  featureOverrides  FeatureFlagOverride[]
  notificationOutbox NotificationOutbox[]
  crmLeads          CrmLead[]
  crmContacts       CrmContact[]
  crmTasks          CrmTask[]
  crmBoards         CrmBoard[]
  crmBoardColumns   CrmBoardColumn[]
  crmBoardItems     CrmBoardItem[]
  connections       WorkspaceConnection[]
  channels          WorkspaceChannel[]
}

model User {
  id                String    @id
  email             String    @unique
  name              String
  passwordHash      String?
  activeWorkspaceId String?
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownedWorkspaces Workspace[]     @relation("WorkspaceOwner")
  members         Member[]
  oauthAccounts   OAuthAccount[]
  authTokens      AuthToken[]
  invitesSent     WorkspaceInvite[] @relation("InviteSender")
  auditEvents     AuditEvent[]      @relation("AuditActor")
  connectionsCreated WorkspaceConnection[] @relation("ConnectionCreator")
  legalConsents   LegalConsent[]
}

/// Append-only record of a user accepting a specific legal document version.
model LegalConsent {
  id          String   @id
  userId      String
  document    String
  version     String
  acceptedAt  DateTime @default(now())
  source      String
  ip          String?
  userAgent   String?
  locale      String?
  authMethod  String?
  workspaceId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document])
  @@index([userId, document, version])
  @@index([acceptedAt])
}

model Member {
  id          String   @id
  workspaceId String
  userId      String
  role        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model OAuthAccount {
  id             String   @id
  provider       String
  providerUserId String
  email          String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId])
}

model AuthToken {
  id        String    @id
  userId    String
  type      String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([tokenHash])
  @@index([expiresAt])
}

model WorkspaceInvite {
  id          String    @id
  workspaceId String
  email       String
  role        String
  tokenHash   String
  invitedById String
  status      String    @default("pending")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  invitedBy User      @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([tokenHash])
}

model Subscription {
  id                   String   @id
  workspaceId          String   @unique
  planId               String   @default("free")
  status               String   @default("active")
  currentPeriodStart   DateTime @default(now())
  currentPeriodEnd     DateTime
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([planId, status])
}

model WorkspaceModule {
  id          String    @id
  workspaceId String
  moduleId    String
  status      String    @default("ENABLED")
  enabledAt   DateTime?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, moduleId])
  @@index([workspaceId, status])
}

model UsageEvent {
  id          String   @id
  workspaceId String
  metric      String
  quantity    Int      @default(1)
  metadata    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, metric, createdAt])
}

model FeatureFlagOverride {
  id          String   @id
  key         String
  scope       String
  enabled     Boolean
  planId      String?
  workspaceId String?
  environment String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([key, scope])
  @@index([workspaceId])
}

model NotificationOutbox {
  id          String    @id
  type        String
  channel     String    @default("email")
  payload     String
  status      String    @default("pending")
  error       String?
  workspaceId String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([status, createdAt])
  @@index([workspaceId])
}

model AuditEvent {
  id          String   @id
  workspaceId String?
  actorId     String?
  targetId    String?
  action      String
  metadata    String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Event {
  id          String    @id
  type        String
  workspaceId String
  payload     String
  status      String    @default("pending")
  error       String?
  occurredAt  DateTime  @default(now())
  processedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([status, occurredAt])
}

model BusinessProfile {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique
  name                  String
  legalName             String?
  description           String?
  industry              String?
  subIndustry           String?
  website               String?
  logo                  String?
  language              String?
  timezone              String?
  emails                String   @default("[]")
  phones                String   @default("[]")
  addresses             String   @default("[]")
  socialProfiles        String   @default("[]")
  services              String   @default("[]")
  products              String   @default("[]")
  classification        String?
  communicationChannels String   @default("[]")
  hypotheses            String   @default("[]")
  confidenceScore       Float?
  verifiedFields        String   @default("[]")
  sourceData            String?
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model BusinessReport {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  facts           String    @default("[]")
  understanding   String
  recommendations String    @default("[]")
  questions       String    @default("[]")
  confidence      Float?
  generatedAt     DateTime  @default(now())
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model InsightRecord {
  id             String   @id
  workspaceId    String
  title          String
  what           String
  why            String
  confidence     Float
  supportingData String
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model RecommendationRecord {
  id             String   @id
  workspaceId    String
  action         String
  rationale      String
  expectedImpact String
  priority       Int
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model CrmLead {
  id          String   @id
  workspaceId String
  name        String
  email       String?
  phone       String?
  source      String?
  status      String   @default("new")
  notes       String?
  contactId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  contact   CrmContact? @relation(fields: [contactId], references: [id])
  tasks     CrmTask[]
  boardItems CrmBoardItem[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([contactId])
}

model CrmContact {
  id          String   @id
  workspaceId String
  name        String
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  leads     CrmLead[]
  tasks     CrmTask[]
  boardItems CrmBoardItem[]

  @@index([workspaceId])
}

model CrmTask {
  id          String    @id
  workspaceId String
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  leadId      String?
  contactId   String?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  lead      CrmLead?    @relation(fields: [leadId], references: [id])
  contact   CrmContact? @relation(fields: [contactId], references: [id])
  boardItems CrmBoardItem[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([leadId])
  @@index([contactId])
}

model CrmBoard {
  id          String   @id
  workspaceId String
  name        String
  preset      String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  columns   CrmBoardColumn[]
  items     CrmBoardItem[]

  @@index([workspaceId])
  @@index([workspaceId, position])
}

model CrmBoardColumn {
  id          String   @id
  workspaceId String
  boardId     String
  key         String
  label       String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  board     CrmBoard      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  items     CrmBoardItem[]

  @@index([workspaceId])
  @@index([boardId, position])
}

model CrmBoardItem {
  id          String   @id
  workspaceId String
  boardId     String
  columnId    String
  title       String
  description String?
  position    Int      @default(0)
  leadId      String?
  contactId   String?
  taskId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  board     CrmBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column    CrmBoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  lead      CrmLead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact   CrmContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  task      CrmTask?       @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([boardId, position])
  @@index([columnId, position])
  @@index([leadId])
  @@index([contactId])
  @@index([taskId])
}

model WorkspaceConnection {
  id                   String   @id
  workspaceId          String
  integrationId        String
  provider             String
  status               String   @default("disconnected")
  capabilities         String   @default("[]")
  externalAccountId    String?
  externalAccountName  String?
  metadata             String?
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id])
  createdBy   User                 @relation("ConnectionCreator", fields: [createdById], references: [id])
  credential  ConnectionCredential?
  channelBindings ChannelConnectionBinding[]

  @@index([workspaceId, integrationId])
  @@index([workspaceId, status])
  @@index([workspaceId, provider])
}

model ConnectionCredential {
  connectionId    String   @id
  ciphertext      String
  keyVersion      Int      @default(1)
  updatedAt       DateTime @updatedAt

  connection WorkspaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model WorkspaceChannel {
  id          String   @id
  workspaceId String
  type        String
  status      String   @default("not_configured")
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  bindings  ChannelConnectionBinding[]

  @@unique([workspaceId, type])
  @@index([workspaceId, status])
}

model ChannelConnectionBinding {
  id           String  @id
  channelId    String
  connectionId String
  isPrimary    Boolean @default(true)

  channel    WorkspaceChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  connection WorkspaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([channelId, connectionId])
  @@index([connectionId])
}
