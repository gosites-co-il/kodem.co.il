# syntax=docker/dockerfile:1

# Static Astro marketing site served by nginx.
# PUBLIC_* values are baked at build time (Astro SSG).

FROM node:22-alpine AS builder
WORKDIR /app

ARG PUBLIC_SITE_URL=http://localhost:4321
ARG PUBLIC_API_URL=http://localhost:3333/api
ARG PUBLIC_APP_SIGNUP_URL=/signup
ARG PUBLIC_WHATSAPP_PHONE=
ARG PUBLIC_GA_MEASUREMENT_ID=
ARG PUBLIC_META_PIXEL_ID=
ARG PUBLIC_LEAD_ENDPOINT=

ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL \
    PUBLIC_API_URL=$PUBLIC_API_URL \
    PUBLIC_APP_SIGNUP_URL=$PUBLIC_APP_SIGNUP_URL \
    PUBLIC_WHATSAPP_PHONE=$PUBLIC_WHATSAPP_PHONE \
    PUBLIC_GA_MEASUREMENT_ID=$PUBLIC_GA_MEASUREMENT_ID \
    PUBLIC_META_PIXEL_ID=$PUBLIC_META_PIXEL_ID \
    PUBLIC_LEAD_ENDPOINT=$PUBLIC_LEAD_ENDPOINT

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN CI=true npx nx build marketing

FROM nginx:1.27-alpine AS runner
COPY docker/nginx.marketing.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/apps/marketing /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1
