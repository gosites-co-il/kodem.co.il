# syntax=docker/dockerfile:1

FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY . .
ENV PRISMA_HIDE_UPDATE_MESSAGE=1
RUN npm run db:generate
RUN CI=true npx nx build api

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PRISMA_HIDE_UPDATE_MESSAGE=1

COPY --from=builder /app/dist/apps/api/package.json ./package.json
COPY --from=builder /app/dist/apps/api/main.js ./main.js
RUN npm install --omit=dev

# The Prisma client is bundled into main.js, but its query engine is loaded from disk
# at runtime, from libs/database/src/generated/<output dir> relative to the working
# directory. Copying the whole generated directory keeps this correct if the schema's
# output path is ever renamed. Both stages are alpine, so the engine binary matches.
COPY --from=builder /app/libs/database/src/generated ./libs/database/src/generated

# The entrypoint runs `prisma migrate deploy` on every start, which needs the CLI, the
# schema and its migrations. It does not need a generated client.
COPY --from=builder /app/libs/database/prisma ./prisma
RUN npm install prisma@6

COPY docker/entrypoint-api.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3333
ENTRYPOINT ["/entrypoint.sh"]
