# Nest API origin for Next.js dev proxy (next.config.js rewrites)
API_ORIGIN=http://localhost:3333

# Marketing homepage for “חזרה לאתר” (local / override)
NEXT_PUBLIC_MARKETING_URL=http://localhost:4321

# Optional override — leave unset to use same-origin /api via proxy
# NEXT_PUBLIC_API_URL=/api
