---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_CONFIG } from '../lib/site-config';

const plan = Astro.url.searchParams.get('plan') ?? '';
const apiUrl = SITE_CONFIG.apiUrl;
---

<SiteLayout
  title="הרשמה — KODEM"
  description="יצירת workspace ב-KODEM"
  path="/signup"
>
  <section class="section-pad">
    <div class="container-site max-w-lg">
      <h1 class="text-3xl font-extrabold sm:text-4xl">יצירת workspace</h1>
      {
        plan ? (
          <p class="mt-2 text-sm text-muted-foreground">
            תוכנית שנבחרה: <strong class="text-foreground">{plan}</strong>
          </p>
        ) : null
      }
      <form id="signup-form" class="bento-card mt-8 flex flex-col gap-4">
        <input type="hidden" name="plan" value={plan} />
        <label class="flex flex-col gap-1.5 text-sm font-medium">
          שם העסק
          <input
            class="h-12 rounded-xl border border-input bg-background px-3"
            name="name"
            required
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm font-medium">
          מזהה workspace (אנגלית)
          <input
            class="h-12 rounded-xl border border-input bg-background px-3"
            name="slug"
            required
            pattern="[a-z0-9-]+"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm font-medium">
          אתר (אופציונלי)
          <input
            class="h-12 rounded-xl border border-input bg-background px-3"
            name="websiteUrl"
            type="url"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm font-medium">
          השם שלך
          <input
            class="h-12 rounded-xl border border-input bg-background px-3"
            name="ownerName"
            required
          />
        </label>
        <label class="flex flex-col gap-1.5 text-sm font-medium">
          אימייל
          <input
            class="h-12 rounded-xl border border-input bg-background px-3"
            name="ownerEmail"
            type="email"
            required
          />
        </label>
        <button
          type="submit"
          class="mt-2 h-12 cursor-pointer rounded-full bg-cta font-semibold text-cta-foreground hover:opacity-90"
        >
          צור workspace
        </button>
      </form>
      <pre
        id="result"
        class="mt-6 hidden overflow-auto rounded-xl bg-muted p-4 text-xs"
        hidden></pre>
    </div>
  </section>
  <script define:vars={{ apiUrl }}>
    const form = document.getElementById('signup-form');
    const result = document.getElementById('result');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      result.hidden = false;
      result.classList.remove('hidden');
      result.textContent = 'יוצרים...';
      try {
        const res = await fetch(`${apiUrl}/workspaces`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        result.textContent = JSON.stringify(json, null, 2);
      } catch (err) {
        result.textContent = `שגיאה: ${err.message}`;
      }
    });
  </script>
</SiteLayout>
