---
import SiteLayout from '../layouts/SiteLayout.astro';
import { HomePage } from '../components/landing/LandingPage';

const title = 'KODEM — מענה ללידים בוואטסאפ תוך 3 שניות';
const description =
  'KODEM לוכד כל ליד, מנהל שיחת מכירה בוואטסאפ, קובע פגישות ומראה כמה כל קמפיין מחזיר. מערכת אחת לעסקים בישראל.';
---

<SiteLayout title={title} description={description} path="/" homeCta>
  <HomePage client:load />
</SiteLayout>
