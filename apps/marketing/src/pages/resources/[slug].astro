---
import SiteLayout from '../../layouts/SiteLayout.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'lead-response-time' },
      props: {
        title: 'למה ליד שנענה תוך 5 דקות סוגר פי 3.5 יותר',
        tag: 'מכירות',
        body: [
          'בשוק הישראלי רוב העסקים עונים לליד אחרי עשרות דקות — לפעמים שעות. בינתיים המתחרה שעונה מהר יותר כבר קבע שיחה.',
          'KODEM לא מחליף אותך בסגירה. הוא מוודא שאף ליד לא מחכה. אתה נכנס כשהלקוח חם ומוכן.',
          'המספר פי 3.5 מתייחס לסגירות יחסיות ללידים שנענו תוך חמש דקות לעומת כאלה שחיכו כשעה — השתמשו בו ככיוון, ובדקו את המספרים שלכם במחשבון.',
        ],
      },
    },
    {
      params: { slug: 'whatsapp-meta-api' },
      props: {
        title: 'וואטסאפ עסקי דרך Meta API: מה חוקי ומה מסוכן',
        tag: 'ציות',
        body: [
          'שליחה המונית מחוץ ל־API הרשמי מסכנת את המספר העסקי. KODEM עובדת רק דרך Meta API עם תבניות מאושרות ומנגנון הסרה.',
          'הלקוח תמיד יכול לבקש אדם — והמערכת מעבירה אליך. שקיפות בונה אמון, וגם עומדת בחוק.',
        ],
      },
    },
    {
      params: { slug: 'roas-funnel' },
      props: {
        title: 'ROAS בלי עיוורון: מהפרסום עד הסגירה',
        tag: 'אנליטיקס',
        body: [
          'קליקים בלי סגירות הם רעש. סגירות בלי מקור הן ניחושים. החיבור בין קמפיין, ליד, שיחה ועסקה הוא מה שהופך פרסום להחלטה.',
          'בדשבורד של KODEM רואים איפה המשפך נשבר — ופעם בשבוע מקבלים המלצה אחת לתיקון.',
        ],
      },
    },
  ];
}

const { title, tag, body } = Astro.props;
const pageTitle = `${title} — KODEM`;
---

<SiteLayout title={pageTitle} description={title} path={Astro.url.pathname}>
  <article class="section-pad">
    <div class="container-site max-w-3xl">
      <a href="/resources" class="text-sm text-muted-foreground hover:text-foreground"
        >← חזרה לידע</a
      >
      <h1 class="mt-6 text-3xl font-extrabold leading-tight sm:text-4xl">{title}</h1>
      <div class="mt-8 space-y-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
        {body.map((p) => <p>{p}</p>)}
      </div>
      <div class="bento-card mt-12">
        <p class="font-semibold">רוצה לראות את המספרים שלך?</p>
        <a
          href="/#loss-calculator"
          class="mt-3 inline-flex cursor-pointer text-sm font-semibold text-cta hover:underline"
        >
          למחשבון ההפסדים →
        </a>
      </div>
    </div>
  </article>
</SiteLayout>
